# API (NestJS). Copy to .env and replace the secrets.
# Matches docker-compose.yml in this folder (Postgres 16).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/interactive_product_showcase
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-at-least-32-random-characters
PORT=4000
CLIENT_ORIGIN=http://localhost:3000
AI_SERVICE_URL=http://127.0.0.1:8000

# Stripe (Dashboard > Developers > API keys)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
