# NOVA Audio API + bundled Postgres (single free-tier Render web service).
# FastAPI AI is NOT started here: OPENAI_API_KEY is empty locally; Next.js /api/ai/* already degrades to catalog RAG-lite.
FROM node:22-bookworm-slim

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    openssl \
    postgresql \
    postgresql-contrib \
    procps \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app/backend

ENV DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/nova_audio

COPY package.json package-lock.json ./
COPY prisma ./prisma
COPY prisma.config.ts ./

RUN npm install --no-audit --no-fund

COPY src ./src
COPY tsconfig.json tsconfig.build.json nest-cli.json ./
COPY docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh

RUN npx prisma generate \
  && npm run build \
  && npm install prisma@6.19.3 --no-save --no-audit --no-fund \
  && chmod +x /usr/local/bin/docker-entrypoint.sh \
  && mkdir -p /var/lib/postgresql/data /var/run/postgresql \
  && chown -R postgres:postgres /var/lib/postgresql /var/run/postgresql

ENV NODE_ENV=production \
    HOST=0.0.0.0 \
    PORT=4000 \
    PGDATA=/var/lib/postgresql/data \
    POSTGRES_USER=postgres \
    POSTGRES_PASSWORD=postgres \
    POSTGRES_DB=nova_audio \
    DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/nova_audio

EXPOSE 4000

ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]